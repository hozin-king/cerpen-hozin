<?xml version="1.0" encoding="utf-8"?>
<!-- Konten yang sudah dibeli (v1.1.32): daftar unlock milik akun dari
     server — satu daftar saja (bukan dua seksi seperti Riwayat). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/purchased_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/purchased_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Konten Dibeli"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/purchased_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/purchased_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Belum ada konten yang dibeli — episode terkunci bisa dibuka dengan koin."
            android:textColor="@color/muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/purchased_offline_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tidak ada internet — menampilkan daftar dari perangkat ini."
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
