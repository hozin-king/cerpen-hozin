<?xml version="1.0" encoding="utf-8"?>
<!-- Header drawer (v1.1.30): nama/ID akun (atau "Guest") + saldo + VIP.
     Diisi runtime dari CoinStore (MainActivity.refreshDrawerHeader). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/paper"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/drawer_header_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guest"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/drawer_header_id"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/drawer_header_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0 koin"
        android:textColor="@color/accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/drawer_header_vip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/accent"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
