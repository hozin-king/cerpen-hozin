<?xml version="1.0" encoding="utf-8"?>
<!-- v1.1.10: 4 tab (Cerpen/Berita/Komik/Koleksi) + dock bawah.
     Tab Cerpen = UI cerpen v1.0 (cari, filter genre, lanjutkan
     membaca, semua cerpen). Tab Koleksi = riwayat baca + bookmark +
     tombol Pengaturan (ala Library YouTube). Tab Berita = hanya
     daftar berita. Tab Komik = hanya daftar komik. Sync manual
     hanya lewat pull-to-refresh; tombol Perbarui + Unduh Semua
     dihapus. Footer tetap di bawah. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="104dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/app_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cerpen Hozin"
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cerita bersambung Indonesia · baca offline"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <ProgressBar
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:visibility="gone" />

        <!-- ============ TAB CERPEN ============ -->
        <LinearLayout
            android:id="@+id/cerpen_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Cari cerpen -->
            <EditText
                android:id="@+id/search_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:hint="Cari judul atau genre..."
                android:padding="12dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionSearch"
                android:inputType="text" />

            <!-- Filter genre -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/genre_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Lanjutkan Membaca -->
            <LinearLayout
                android:id="@+id/continue_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_accent"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LANJUTKAN MEMBACA"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/continue_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/continue_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/continue_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Lanjutkan"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- Semua Cerpen -->
            <TextView
                android:id="@+id/all_cerpen_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Semua Cerbung"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- v1.1.5: tinggi TETAP + nested scrolling agar RecyclerView
                 benar-benar me-recycle (lazy render). Sebelumnya
                 wrap_content di dalam ScrollView membuat SEMUA item
                 (916 berita) di-bind sekaligus — lag + boros RAM.
                 Daftar kini scroll sendiri di dalam viewport-nya. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/cerpen_list"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="true" />
        </LinearLayout>

        <!-- ============ TAB BERITA ============ -->
        <LinearLayout
            android:id="@+id/news_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/news_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Berita Teknologi"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/news_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dari arsip berita otomatis · tersimpan offline · ketuk untuk baca lengkap"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/news_list"
                android:layout_width="match_parent"
                android:layout_height="560dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="true" />
        </LinearLayout>

        <!-- ============ TAB KOMIK ============ -->
        <LinearLayout
            android:id="@+id/komik_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/komik_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Komik"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/komik_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gambar komik diunduh otomatis / saat tarik ke bawah untuk refresh"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/komik_list"
                android:layout_width="match_parent"
                android:layout_height="480dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="true" />
        </LinearLayout>

        <!-- ============ TAB KOLEKSI ============ -->
        <LinearLayout
            android:id="@+id/koleksi_tab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/koleksi_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Koleksi"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/koleksi_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Riwayat baca dan yang ditandai — semua tersimpan di perangkat"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/koleksi_settings_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="⚙ Pengaturan"
                android:textColor="@color/white" />

            <!-- Riwayat Baca -->
            <LinearLayout
                android:id="@+id/history_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/history_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Riwayat Baca"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/history_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <!-- Ditandai (Bookmark) -->
            <LinearLayout
                android:id="@+id/bookmark_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/bookmark_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Ditandai 🔖"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/bookmark_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- v1.1.4: progres sync/unduh (bilah + teks tahap) — dipakai pull-to-refresh. -->
        <ProgressBar
            android:id="@+id/sync_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/sync_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mengunduh…"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- v1.2: angka versi DIHAPUS dari layout — diisi runtime dari
             BuildConfig.VERSION_NAME (MainActivity) agar selalu benar. -->
        <TextView
            android:id="@+id/app_footer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Cerpen Hozin · semua konten tersimpan di perangkat"
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- ============ BOTTOM DOCK KACA (v1.1.8) ============ -->
    <!-- Pill mengambang + bubble Cari bundar menonjol 18dp ke atas.
         Background pill + bubble diisi runtime dari ThemeHelper agar
         ikut tema (terang/sepia/malam) — di XML sengaja tanpa
         background. Tanpa blur live: kaca = warna kartu tembus pandang
         + stroke tipis + elevation (statis, tanpa biaya per-frame). -->
    <FrameLayout
        android:id="@+id/dock_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:paddingTop="18dp">

        <LinearLayout
            android:id="@+id/dock_bar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:elevation="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/dock_cerbung"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dock_cerbung_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/dock_cerbung_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cerbung"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_berita"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dock_berita_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📰"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/dock_berita_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Berita"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Sel kosong: tempat bubble Cari menumpang di atas pill. -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/dock_komik"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dock_komik_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📚"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/dock_komik_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Komik"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dock_koleksi"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/dock_koleksi_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/dock_koleksi_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Koleksi"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/dock_cari"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center_horizontal"
            android:clickable="true"
            android:elevation="12dp"
            android:focusable="true">

            <TextView
                android:id="@+id/dock_cari_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🔍"
                android:textSize="24sp" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
