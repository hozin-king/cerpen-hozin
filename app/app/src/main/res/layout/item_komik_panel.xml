<?xml version="1.0" encoding="utf-8"?>
<!-- Satu panel komik gaya Webtoon (v1.1.26): gambar full-width tanpa
     distorsi, teks dialog di bawahnya, jeda antar panel konsisten. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/panel_image"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:contentDescription="Panel komik"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/panel_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="Panel belum terunduh — ketuk tombol unduh di atas."
        android:textColor="@color/muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/panel_teks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:lineSpacingMultiplier="1.4"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/ink_soft"
        android:textSize="15sp" />
</LinearLayout>
