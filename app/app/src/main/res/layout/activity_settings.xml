<?xml version="1.0" encoding="utf-8"?>
<!-- Layar Pengaturan (v1.1.30, dirapikan): tiga kelompok — Akun (ID perangkat/
     ID akun + saldo koin + VIP + privasi papan peringkat + Dukung kreator),
     Konten (ukuran teks + tema), Aplikasi (periksa pembaruan + versi).
     Bahasa visual sama seperti sebelumnya (paper/ink/muted/accent);
     tanpa placeholder, tanpa emoji. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pengaturan"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- ============ AKUN ============ -->
        <TextView
            android:id="@+id/settings_section_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Akun"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/acc_account_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/acc_device_id_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Perangkat"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/acc_device_id_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="1"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/acc_device_id_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="Salin"
                    android:textColor="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/acc_account_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/acc_account_id_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID Akun"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/acc_account_id_value"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/acc_account_id_copy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text="Salin"
                        android:textColor="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/acc_username"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/acc_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="0 koin"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/acc_balance_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="terakhir diperbarui: belum pernah"
                android:textColor="@color/muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/acc_vip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/acc_login_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Masuk / Daftar"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/acc_redeem_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tukar Kode"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/acc_logout_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keluar"
                android:textColor="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/acc_privacy_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/acc_privacy_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sembunyikan saya dari papan peringkat"
                    android:textColor="@color/ink"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/acc_privacy_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dukung kreator (sukarela, BUKAN beli koin) — tampil hanya bila
             donate_url terisi di config online. -->
        <LinearLayout
            android:id="@+id/acc_donate_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/acc_donate_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dukung kreator"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/acc_donate_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Dukungan sukarela lewat Saweria"
                android:textColor="@color/muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ============ KONTEN ============ -->
        <TextView
            android:id="@+id/settings_section_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Konten"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/set_size_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Ukuran Teks"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/set_smaller"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A-"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/set_size_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="17sp"
                android:textColor="@color/ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/set_bigger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="A+"
                android:textColor="@color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/set_theme_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tema"
            android:textColor="@color/ink"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/theme_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Siang"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/theme_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Malam"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/theme_sepia"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Sepia"
                android:textColor="@color/white" />
        </LinearLayout>

        <!-- ============ APLIKASI ============ -->
        <TextView
            android:id="@+id/settings_section_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Aplikasi"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- v1.1.15: cek update manual — lewati throttle 6 jam + abaikan
             dismissed_tag (dijalankan MainActivity saat kembali). -->
        <Button
            android:id="@+id/set_check_update"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Periksa Pembaruan"
            android:textColor="@color/white" />

        <!-- v1.2: angka versi DIHAPUS dari layout — diisi runtime dari
             BuildConfig.VERSION_NAME (SettingsActivity) agar selalu benar. -->
        <TextView
            android:id="@+id/settings_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="32dp"
            android:text="Cerpen Hozin"
            android:textColor="@color/muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
