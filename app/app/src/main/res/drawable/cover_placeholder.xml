<?xml version="1.0" encoding="utf-8"?>
<!-- v1.1.33: placeholder sampul yang layak — gradasi teal lembut +
     ikon buku di tengah (dulu kotak beige polos). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#DDE9E6"
                android:endColor="#AECFC6"
                android:type="linear" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item
        android:width="48dp"
        android:height="48dp"
        android:gravity="center"
        android:drawable="@drawable/ic_book" />
</layer-list>
