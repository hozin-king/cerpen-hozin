<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Izin internet HANYA untuk sync konten opsional dari GitHub raw.
         Tanpa internet pun aplikasi jalan penuh dengan data lokal. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v1.1.5: instal APK update dari dalam aplikasi (Android 8+ wajib
         izin ini; pengguna tetap menyetujui instalasi di layar sistem). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CerpenHozin">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- v1.1.20: App Links — tautan berbagi https://hozinking.my.id/s/<token>.
                 autoVerify=true: sistem memverifikasi assetlinks.json di
                 domain; bila verifikasi gagal, tautan tetap bisa dibuka
                 lewat pemilih aplikasi (tidak crash). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="hozinking.my.id"
                    android:pathPrefix="/s/" />
            </intent-filter>
            <!-- v1.1.22: App Links cadangan — tautan berbagi dari host
                 fallback https://hozin-cms.muchammadhozin.workers.dev/s/<token>
                 (bila domain utama mati). assetlinks.json di host itu
                 isinya sama (package + fingerprint rilis). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="hozin-cms.muchammadhozin.workers.dev"
                    android:pathPrefix="/s/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:parentActivityName=".DetailActivity" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".NewsDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".KomikDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".KomikReaderActivity"
            android:exported="false"
            android:parentActivityName=".KomikDetailActivity" />

        <!-- v1.1.30: layar koin/akun (semua internal, exported=false). -->
        <activity
            android:name=".AccountActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LeaderboardActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".HistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- v1.1.5: bagikan APK update yang terunduh ke installer sistem. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
